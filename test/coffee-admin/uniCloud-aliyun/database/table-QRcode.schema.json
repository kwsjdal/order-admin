{
	"bsonType": "object",
	"required": [],
	"permission": {
		"read": false,
		"create": false,
		"update": false,
		"delete": false
	},
	"properties": {
		"_id": {
			"description": "ID，系统自动生成"
		},
		"table_number": {
			"bsonType": "string",
			"description": "桌号",
			"label": "桌号"
		},
		"qr_code_url": {
			"bsonType": "string",
			"description": "点餐二维码",
			"label": "点餐二维码"
		},
		"create_date": {
			"bsonType": "timestamp",
			"description": "创建时间",
			"label": "创建时间",
			"defaultValue": {
				"$env": "now"
			}
		}
	}
}